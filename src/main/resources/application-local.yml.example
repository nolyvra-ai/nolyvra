# Copy this file to application-local.yml for local development.
# Do not commit application-local.yml.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/nolyvra
    username: nolyvra
    password: nolyvrapass
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 12MB

nolyvra:
  mock-ai: true

coworker:
  analysis-pool-size: 3

analysis-jobs:
  max-parallel: 3
  max-attempts: 3
  worker-delay-ms: 1000
